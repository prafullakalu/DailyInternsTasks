{
  "compilerOptions": {
    // File structure
    "rootDir": "./src",
    "outDir": "./dist",

    // Node environment
    "module": "commonjs",
    "target": "ES2020",
    "lib": ["ES2020"],
    "types": ["node"],

    // Interop (VERY IMPORTANT)
    "esModuleInterop": true,

    // Strictness
    "strict": true,

    // Debugging
    "sourceMap": true,

    // Performance
    "skipLibCheck": true
  }
}