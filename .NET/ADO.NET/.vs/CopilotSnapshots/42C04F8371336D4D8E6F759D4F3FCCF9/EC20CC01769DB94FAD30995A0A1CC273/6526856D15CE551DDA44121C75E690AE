using System.Text;
using Microsoft.AspNetCore.Authentication.JwtBearer;
using Microsoft.IdentityModel.Tokens;
using Microsoft.OpenApi.Models;
using CleanApiProject.Data;
using CleanApiProject.Filters;
using CleanApiProject.Helpers;
using CleanApiProject.Interfaces;
using CleanApiProject.Middleware;
using CleanApiProject.Repositories;
using CleanApiProject.Services;

// ═══════════════════════════════════════════════════════════════════════════
//  PROGRAM.CS — Application Entry Point
//  This file wires everything together:
//   1. Register all services (DI container)
//   2. Configure middleware pipeline
//   3. Initialize database
// ═══════════════════════════════════════════════════════════════════════════

var builder = WebApplication.CreateBuilder(args);

// ── STEP 1: Configure File Logging ───────────────────────────────────────
// Adds our custom FileLogger so all ILogger<T> calls also write to disk.
// Log file path comes from appsettings.json → Logging:LogFilePath
var logFilePath = builder.Configuration["Logging:LogFilePath"] ?? "Logs/app-log.txt";
builder.Logging.AddProvider(new FileLoggerProvider(logFilePath));
builder.Logging.AddConsole();   // Also keep console logging (visible in terminal)


// ── STEP 2: Register Services (Dependency Injection) ─────────────────────

// ── Database ──
// DatabaseHelper wraps SqlConnection creation. It's a singleton because
// the connection string doesn't change. Actual connections are opened/closed per-request.
builder.Services.AddSingleton<DatabaseHelper>();

// ── Repositories (talk to the database) ──
// Scoped: one instance per HTTP request — correct for database operations
builder.Services.AddScoped<IUserRepository, UserRepository>();
builder.Services.AddScoped<IItemRepository, ItemRepository>();

// ── Services (contain business logic) ──
builder.Services.AddScoped<IAuthService, AuthService>();
builder.Services.AddScoped<IUserService, UserService>();
builder.Services.AddScoped<IItemService, ItemService>();
builder.Services.AddScoped<ITokenService, TokenService>();


// ── STEP 3: Configure Controllers + Global Filters ────────────────────────
// ValidationFilter     → checks ModelState before every action (returns 400 if invalid)
// RoleValidationFilter → checks if JWT role is still valid (returns 401 if role changed)
builder.Services.AddControllers(options =>
{
    options.Filters.Add<ValidationFilter>();      // Order 1: validate model
    options.Filters.Add<RoleValidationFilter>();  // Order 2: validate role
});


// ── STEP 4: Configure JWT Authentication ─────────────────────────────────
// How JWT Auth works in ASP.NET Core:
//  1. Client sends: Authorization: Bearer eyJhbGci...
//  2. JwtBearer middleware validates the token (signature, expiry, issuer, audience)
//  3. If valid → populates HttpContext.User with claims from the token
//  4. [Authorize] attributes then check the claims (e.g. Role)
var jwtSettings = builder.Configuration.GetSection("JwtSettings");
var secretKey = jwtSettings["SecretKey"]!;
var issuer = jwtSettings["Issuer"]!;
var audience = jwtSettings["Audience"]!;

builder.Services
    .AddAuthentication(options =>
    {
        options.DefaultAuthenticateScheme = JwtBearerDefaults.AuthenticationScheme;
        options.DefaultChallengeScheme = JwtBearerDefaults.AuthenticationScheme;
    })
    .AddJwtBearer(options =>
    {
        options.TokenValidationParameters = new TokenValidationParameters
        {
            ValidateIssuer = true,
            ValidateAudience = true,
            ValidateLifetime = true,   // Rejects expired tokens
            ValidateIssuerSigningKey = true,
            ValidIssuer = issuer,
            ValidAudience = audience,
            IssuerSigningKey = new SymmetricSecurityKey(Encoding.UTF8.GetBytes(secretKey)),
            ClockSkew = TimeSpan.Zero  // No tolerance — token expires exactly at ExpiryMinutes
        };

        // Return clean JSON for 401/403 instead of empty responses
        options.Events = new JwtBearerEvents
        {
            OnChallenge = async ctx =>
            {
                ctx.HandleResponse();
                ctx.Response.StatusCode = 401;
                ctx.Response.ContentType = "application/json";
                await ctx.Response.WriteAsync(
                    """{"success":false,"message":"Unauthorized. Please provide a valid JWT token."}""");
            },
            OnForbidden = async ctx =>
            {
                ctx.Response.StatusCode = 403;
                ctx.Response.ContentType = "application/json";
                await ctx.Response.WriteAsync(
                    """{"success":false,"message":"Forbidden. You don't have permission to access this resource."}""");
            }
        };
    });

builder.Services.AddAuthorization();


// ── STEP 5: Configure Swagger with JWT Support ───────────────────────────
// Swagger lets you test all endpoints from the browser.
// The "Authorize" button in Swagger allows you to enter your JWT token.
builder.Services.AddEndpointsApiExplorer();
builder.Services.AddSwaggerGen(options =>
{
    options.SwaggerDoc("v1", new OpenApiInfo
    {
        Title = "CleanApiProject",
        Version = "v1",
        Description = "ASP.NET Core Web API with JWT Auth, Role-Based Access, and ADO.NET"
    });

    // Add JWT Bearer input to Swagger UI
    // This adds the "Authorize 🔒" button at the top of Swagger
    options.AddSecurityDefinition("Bearer", new OpenApiSecurityScheme
    {
        Name = "Authorization",
        Type = SecuritySchemeType.ApiKey,
        Scheme = "Bearer",
        BearerFormat = "JWT",
        In = ParameterLocation.Header,
        Description = "Enter: Bearer {your_token_here}\n\nExample: Bearer eyJhbGci..."
    });

    options.AddSecurityRequirement(new OpenApiSecurityRequirement
    {
        {
            new OpenApiSecurityScheme
            {
                Reference = new OpenApiReference
                {
                    Type = ReferenceType.SecurityScheme,
                    Id   = "Bearer"
                }
            },
            Array.Empty<string>()
        }
    });
});


// ══════════════════════════════════════════════════════════════════════════
//  BUILD THE APP & CONFIGURE MIDDLEWARE PIPELINE
//  ORDER MATTERS: middleware runs top-to-bottom on request, bottom-to-top on response
// ══════════════════════════════════════════════════════════════════════════
var app = builder.Build();


// ── STEP 6: Initialize Database ──────────────────────────────────────────
// Creates tables and inserts seed data if they don't exist yet.
// Runs once at startup — safe to call multiple times (uses IF NOT EXISTS).
using (var scope = app.Services.CreateScope())
{
    await DatabaseInitializer.InitializeAsync(scope.ServiceProvider);
}


// ── STEP 7: Middleware Pipeline ───────────────────────────────────────────
// 1. ExceptionHandlingMiddleware — MUST be FIRST to catch errors from all later middleware
app.UseMiddleware<ExceptionHandlingMiddleware>();

// 2. LoggingMiddleware — logs every request/response
app.UseMiddleware<LoggingMiddleware>();

// 3. Swagger UI (only in Development for security)
if (app.Environment.IsDevelopment())
{
    app.UseSwagger();
    app.UseSwaggerUI(c =>
    {
        c.SwaggerEndpoint("/swagger/v1/swagger.json", "CleanApiProject v1");
        c.RoutePrefix = string.Empty;  // Swagger available at root: https://localhost:5001/
    });
}

app.UseHttpsRedirection();

// 4. Authentication MUST come before Authorization
app.UseAuthentication();
app.UseAuthorization();

app.MapControllers();

app.Run();
