            "schema": {
              "type": "string"
            }
          },
          {
            "name": "realmId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
